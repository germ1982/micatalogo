; Copiá este archivo como .env y completá los datos de ESTE servidor.
; .env nunca se sube al repositorio.
DB_HOST = "localhost"
DB_NAME = "micatalogo"
DB_USERNAME = "root"
DB_PASSWORD = ""
; Una frase larga cualquiera, distinta en cada servidor (protege las cookies)
COOKIE_KEY = "cambiar-por-una-frase-larga-y-al-azar"
; 1 en tu PC (muestra los errores con detalle), 0 en el servidor
DEBUG = 1
; 1 para ver la barra de depuración de Yii abajo a la derecha (solo con DEBUG = 1)
DEBUG_TOOLBAR = 0
